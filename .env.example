# Copie para .env.local e preencha. NUNCA commite .env.local nem cole chaves em chats.
# Em produção no app, a chave do OpenRouter vai para o keychain via tela de Configurações.

# --- Fase 1: IA ---
OPENROUTER_API_KEY=
# Opcional: aponta para outro servidor compatível (ex.: Ollama local http://localhost:11434/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Fase 5: AWS (CDK) ---
AWS_PROFILE=
AWS_REGION=sa-east-1

# --- Fase 5/6: credenciais da Meta NÃO ficam aqui. Vão para o SSM com `pnpm relay:set-secret`. ---
