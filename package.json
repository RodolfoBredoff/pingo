{
  "name": "pingo",
  "private": true,
  "version": "0.0.0",
  "description": "Pingo: agente de WhatsApp local-first que organiza recados em agenda e lembretes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "relay:test": "pnpm --filter @pingo/relay test",
    "relay:deploy": "AWS_PROFILE=${AWS_PROFILE:-publishing} pnpm --filter @pingo/relay deploy",
    "relay:diff": "AWS_PROFILE=${AWS_PROFILE:-publishing} pnpm --filter @pingo/relay diff",
    "relay:smoke": "AWS_PROFILE=${AWS_PROFILE:-publishing} pnpm --filter @pingo/relay smoke",
    "relay:set-secret": "AWS_PROFILE=${AWS_PROFILE:-publishing} pnpm --filter @pingo/relay set-secret",
    "relay:pair-code": "AWS_PROFILE=${AWS_PROFILE:-publishing} pnpm --filter @pingo/relay pair-code",
    "android:doctor": "bash scripts/android-doctor.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
